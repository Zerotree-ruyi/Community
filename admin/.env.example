# 部署时 cp 此文件为 .env 并填真实密码
# B 台(47.236.95.137)的 MySQL 配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zero
DB_PASS=CHANGE_ME_BEFORE_PROD
DB_NAME=zero
# API 监听端口(PM2 会启动这个端口)
PORT=3001

# ════════════════════════════════════════════════════════════════════
# 安全配置(全部有默认值,不填也能跑;生产建议按下面说明打开)
# ════════════════════════════════════════════════════════════════════

# 跨域白名单 —— 逗号分隔的完整 Origin,比如:
#   ALLOWED_ORIGINS=https://coinbase-in.com,http://localhost:5177
# 不填 = 只允许同源(本机 curl / nginx 反代 / vite 代理都不受影响)。
# ⚠️ 以前这里是 cors() = 任意网站都能调你的接口,一定要改。
ALLOWED_ORIGINS=

# HSTS —— 只有真的上了 HTTPS 才设成 1。
#   纯 HTTP 下设了会把浏览器锁死在 https://,访问不了。
ENABLE_HSTS=0

# Cookie 的 secure 标志 —— 只有真上了 HTTPS 才设成 1。
#   纯 HTTP 下设成 1,浏览器会直接拒收这个 cookie,会员登录态就没了。
COOKIE_SECURE=0

# 兼容老的 X-Admin-Id 头 —— 默认关闭(生产绝对不要开)。
#   开着 = 任何人加一句 X-Admin-Id: 1 就是超级管理员。
#   只在灰度期 / 本地老脚本没改完时可以临时设成 1。
ALLOW_LEGACY_ADMIN_HEADER=0
